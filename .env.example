# Copy this file to .env and adjust as needed.
# Loaded by both the Rust backend (src-tauri, via dotenvy) and the Vite
# frontend (apps/desktop, via envDir in vite.config.ts).

# --- Rust backend (agent-core) ---

# Gateway endpoint the desktop app streams chat completions from.
EURY_AGENT_GATEWAY_URL=http://localhost:3001/agent/v1/chat/stream

# Set to "memory" to skip persisting auth tokens to the OS keychain
# (avoids repeated Keychain prompts during local dev; tokens will not
# survive an app restart in this mode).
EURY_AGENT_AUTH_STORE=memory

# --- Frontend (apps/desktop, Vite — must be prefixed with VITE_) ---

# NestJS backend, serves /agent/v1/*
VITE_EURY_AGENT_API_URL=http://localhost:3001

# Next.js web app, serves /agent/authorize
VITE_AGENT_WEB_URL=http://localhost:3000
VITE_AGENT_WEB_LOCALE=en
